{#-
  Canonical content-dashboard template. SINGLE SOURCE OF TRUTH.
  Rendered by scripts/build_content_dashboard.py with Jinja2 autoescape=ON.
  The weekly task NEVER edits this file — it only produces the data JSON.
  Data physically cannot break markup: every value is auto-escaped, and copy
  prompts live in a JSON map keyed by id, never in an HTML attribute.
-#}
<!DOCTYPE html>
<!-- GENERATED — do not edit. builder=scripts/build_content_dashboard.py
     templateId={{ prov.template_id }} templateVersion={{ prov.version }}
     templateSha256={{ prov.sha256 }} dataSchema={{ prov.schema }}
     page={{ page_type }} generatedAt={{ prov.generated_at }} -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="dashboard-template-id" content="{{ prov.template_id }}">
<meta name="dashboard-template-version" content="{{ prov.version }}">
<meta name="dashboard-template-sha256" content="{{ prov.sha256 }}">
<title>{{ page_title }} — {{ week.label }}</title>
<style>
:root{
  --page-bg:#F8FAFC;--surface:#FFFFFF;--surface-muted:#F1F5F9;
  --border:#E2E8F0;--border-strong:#CBD5E1;
  --text:#0F172A;--text-secondary:#475569;--text-muted:#64748B;
  --accent:#2563EB;--accent-hover:#1D4ED8;--accent-soft:#EFF6FF;--focus-ring:#BFDBFE;
  --success:#059669;--success-soft:#ECFDF5;
  --radius-card:18px;--radius-control:10px;--radius-pill:999px;
}
*{box-sizing:border-box}
body{margin:0;background:var(--page-bg);color:var(--text);
  font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;}
a{color:inherit}
.dashboard-shell{max-width:1200px;margin:0 auto;padding:32px 24px 56px}
@media(min-width:1440px){.dashboard-shell{max-width:1280px}}
@media(max-width:767px){.dashboard-shell{padding:20px 16px 40px}}
.dashboard-header{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;
  padding-bottom:24px;margin-bottom:20px;border-bottom:1px solid var(--border)}
@media(max-width:767px){.dashboard-header{display:block}}
.dashboard-title{margin:0;font-size:32px;line-height:40px;font-weight:700;letter-spacing:-0.03em}
@media(max-width:767px){.dashboard-title{font-size:26px;line-height:34px}}
.dashboard-subtitle{margin:8px 0 0;max-width:760px;font-size:15px;line-height:24px;color:var(--text-secondary)}
.header-meta{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px}
@media(max-width:767px){.header-meta{justify-content:flex-start;margin-top:16px}}
.meta-chip{display:inline-flex;align-items:center;height:28px;padding:0 10px;border:1px solid var(--border);
  border-radius:var(--radius-pill);background:var(--surface);color:var(--text-secondary);
  font-size:12px;line-height:16px;font-weight:600}
.dashboard-tabs{display:flex;gap:8px;margin-bottom:28px;overflow-x:auto;-webkit-overflow-scrolling:touch}
.dashboard-tab{display:inline-flex;align-items:center;height:36px;padding:0 14px;border-radius:var(--radius-pill);
  border:1px solid var(--border-strong);background:var(--surface);color:#334155;font-size:14px;line-height:20px;
  font-weight:600;text-decoration:none;white-space:nowrap}
.dashboard-tab[aria-current="page"]{background:var(--accent);border-color:var(--accent);color:#fff}
.funnel-section{margin-top:32px}
.funnel-section:first-of-type{margin-top:0}
.section-header{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:14px}
.section-title{margin:0;font-size:22px;line-height:30px;font-weight:700;letter-spacing:-0.02em}
.section-count{font-size:13px;line-height:20px;font-weight:600;color:var(--text-muted)}
@media(max-width:767px){.section-header{display:block}.section-title{font-size:20px;line-height:28px}
  .section-count{display:block;margin-top:4px}}
.topic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:stretch}
@media(max-width:1099px){.topic-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:767px){.topic-grid{grid-template-columns:1fr;gap:14px}}
.topic-card{position:relative;display:flex;flex-direction:column;padding:18px;border:1px solid var(--border);
  border-radius:var(--radius-card);background:var(--surface);overflow:hidden;
  box-shadow:0 1px 2px rgba(15,23,42,.04),0 8px 24px rgba(15,23,42,.04)}
.topic-card::before{content:"";position:absolute;left:0;top:18px;bottom:18px;width:4px;
  border-radius:0 999px 999px 0;background:var(--stage)}
.topic-card:hover{border-color:var(--border-strong);box-shadow:0 1px 2px rgba(15,23,42,.05),0 12px 28px rgba(15,23,42,.07)}
@media(max-width:767px){.topic-card{padding:16px;border-radius:16px}}
.topic-card[data-stage="BOFU"]{--stage:#059669;--stage-bg:#ECFDF5;--stage-border:#A7F3D0;--stage-text:#047857}
.topic-card[data-stage="MOFU"]{--stage:#D97706;--stage-bg:#FFFBEB;--stage-border:#FDE68A;--stage-text:#92400E}
.topic-card[data-stage="TOFU"]{--stage:#7C3AED;--stage-bg:#F5F3FF;--stage-border:#DDD6FE;--stage-text:#6D28D9}
.topic-card[data-pick="true"]{border-color:#334155;box-shadow:0 0 0 1px #334155,0 14px 30px rgba(15,23,42,.12)}
.card-meta-row{display:flex;align-items:center;gap:8px;margin-bottom:12px}
.stage-pill{display:inline-flex;align-items:center;height:24px;padding:0 8px;border-radius:var(--radius-pill);
  border:1px solid var(--stage-border);background:var(--stage-bg);color:var(--stage-text);
  font-size:11px;line-height:16px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.pick-badge{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 10px;border-radius:var(--radius-pill);
  background:#0F172A;color:#fff;font-size:12px;line-height:16px;font-weight:700}
.pick-badge .star{color:#FBBF24}
.card-index{margin-left:auto;color:var(--text-muted);font-size:12px;line-height:16px;font-weight:600}
.card-title{margin:0;font-size:18px;line-height:24px;font-weight:700;letter-spacing:-0.015em;overflow-wrap:anywhere}
.why-label,.sec-label{margin-top:14px;font-size:11px;line-height:16px;font-weight:700;letter-spacing:.06em;
  text-transform:uppercase;color:var(--text-muted)}
.card-why{margin:4px 0 0;font-size:14px;line-height:22px;color:var(--text-secondary);overflow-wrap:anywhere}
.chip-row{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.chip{display:inline-flex;align-items:center;height:24px;padding:0 9px;border-radius:var(--radius-pill);
  border:1px solid var(--border);background:var(--surface-muted);color:var(--text-secondary);
  font-size:12px;line-height:16px;font-weight:600}
.aeo-quote{margin:8px 0 0;padding:10px 12px;border-left:3px solid var(--stage);background:var(--surface-muted);
  border-radius:0 10px 10px 0;font-size:13px;line-height:20px;color:var(--text)}
.score-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(88px,1fr));gap:8px;margin-top:16px}
@media(max-width:420px){.score-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.score-chip{padding:8px 10px;border:1px solid var(--border);border-radius:12px;background:var(--surface-muted)}
.score-label{display:block;font-size:10px;line-height:14px;font-weight:700;letter-spacing:.06em;
  text-transform:uppercase;color:var(--text-muted)}
.score-value{display:block;margin-top:2px;font-size:15px;line-height:20px;font-weight:700}
details.treatment{margin-top:10px;border:1px solid var(--border);border-radius:12px;background:var(--surface-muted)}
details.treatment>summary{cursor:pointer;list-style:none;padding:10px 12px;font-size:13px;font-weight:700;color:var(--text)}
details.treatment>summary::-webkit-details-marker{display:none}
details.treatment .treatment-body{padding:0 12px 12px;font-size:13px;line-height:20px;color:var(--text-secondary);overflow-wrap:anywhere}
.signal-panel{margin-top:14px;border:1px solid var(--border);border-radius:12px;background:var(--surface-muted)}
.signal-heading{margin:0;padding:10px 12px 0;font-size:11px;line-height:16px;font-weight:700;letter-spacing:.06em;
  text-transform:uppercase;color:var(--text-muted)}
.signal-body{margin:0;padding:4px 12px 12px;font-size:13px;line-height:20px;color:var(--text-secondary);overflow-wrap:anywhere}
.card-actions{display:flex;gap:8px;margin-top:auto;padding-top:16px;border-top:1px solid #F1F5F9}
@media(max-width:767px){.card-actions{flex-direction:column}}
.copy-button{min-height:40px;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:0 12px;
  border-radius:var(--radius-control);border:1px solid var(--border-strong);background:var(--surface);color:var(--text);
  font-size:14px;line-height:20px;font-weight:700;cursor:pointer;white-space:nowrap;flex:1}
.copy-button-primary{border-color:var(--accent);background:var(--accent);color:#fff}
.copy-button-primary:hover{border-color:var(--accent-hover);background:var(--accent-hover)}
.copy-button-secondary:hover{border-color:#94A3B8;background:#F8FAFC}
.copy-button:focus-visible{outline:3px solid var(--focus-ring);outline-offset:2px}
.copy-button[data-state="copied"]{border-color:var(--success);background:var(--success-soft);color:#047857}
@media(max-width:767px){.copy-button{width:100%;min-height:44px}}
details.methodology{margin:0 0 28px;border:1px solid var(--border);border-radius:var(--radius-card);background:#F5F3FF}
details.methodology>summary{cursor:pointer;list-style:none;padding:16px 18px;font-size:16px;font-weight:700;color:#6D28D9}
details.methodology .methodology-body{padding:0 18px 18px;font-size:14px;line-height:22px;color:var(--text-secondary)}
.data-table{width:100%;border-collapse:collapse;margin-top:8px;font-size:13px}
.data-table th,.data-table td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--border)}
.data-table th{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted)}
.footer{margin-top:40px;padding-top:18px;border-top:1px solid var(--border);font-size:12px;
  line-height:18px;color:var(--text-muted)}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<div class="dashboard-shell">
  <header class="dashboard-header">
    <div>
      <h1 class="dashboard-title">{{ page_title }}</h1>
      <p class="dashboard-subtitle">{{ page_subtitle }}</p>
    </div>
    <div class="header-meta">
      <span class="meta-chip">{{ week.label }}</span>
      <span class="meta-chip">{{ topic_count }} topics</span>
      <span class="meta-chip">Template v{{ prov.version }}</span>
    </div>
  </header>

  <nav class="dashboard-tabs" aria-label="Dashboard pages">
    <a class="dashboard-tab" href="blogs.html" {% if page_type=='blogs' %}aria-current="page"{% endif %}>Blogs</a>
    <a class="dashboard-tab" href="videos.html" {% if page_type=='videos' %}aria-current="page"{% endif %}>Videos</a>
    <a class="dashboard-tab" href="research.html" {% if page_type=='research' %}aria-current="page"{% endif %}>Research</a>
  </nav>

  {% if page_type == 'research' %}
  <details class="methodology" open>
    <summary>How this dashboard picks the week's topics</summary>
    <div class="methodology-body">
      <p>Five live data sources are scraped each week (Search Console, Reddit, Instagram polls, YouTube comments, Zillow Q&amp;A). A topic's <strong>signal strength</strong> rises when independent sources converge on it: 1 source = 20, 2 = 50, 3 = 75 (minimum for a ⭐ pick), 4 = 85, 5 = 95+, with bonuses for fast-rising demand and high emotional temperature. Each surviving topic is then scored 0–25 on intent, demand, source confirmation, emotional pull, and local relevance, tagged BOFU/MOFU/TOFU, and organized one-per-funnel across the seven days. Exactly one ⭐ pick per day. The raw evidence behind every card is in the <strong>Internal signal</strong> panels below.</p>
    </div>
  </details>
  {% endif %}

  {% for section in sections %}
  <section class="funnel-section">
    <div class="section-header">
      <h2 class="section-title">{{ section.label }}</h2>
      <span class="section-count">{{ section.topics|length }} topics</span>
    </div>
    <div class="topic-grid">
      {% for t in section.topics %}
      <article class="topic-card" data-topic-card data-stage="{{ t.stage }}" {% if t.pick %}data-pick="true"{% endif %}>
        <div class="card-meta-row">
          <span class="stage-pill">{{ t.stage }}</span>
          {% if t.pick %}<span class="pick-badge"><span class="star">★</span>Pick</span>{% endif %}
          {% if t.ghl %}<span class="card-index">Keyword: {{ t.ghl }}</span>{% endif %}
        </div>
        <h3 class="card-title">{{ t.title }}</h3>

        <div class="why-label">Why this, this week</div>
        <p class="card-why">{{ t.humanWhy }}</p>

        {% if page_type == 'blogs' %}
          {% if t.blog.seoKeywords %}
          <div class="sec-label">SEO keywords</div>
          <div class="chip-row">{% for k in t.blog.seoKeywords %}<span class="chip">{{ k }}</span>{% endfor %}</div>
          {% endif %}
          {% if t.blog.aeoPrimary %}<div class="aeo-quote">{{ t.blog.aeoPrimary }}</div>{% endif %}
        {% endif %}

        {% if page_type == 'videos' %}
          {% if t.video.longform %}<details class="treatment"><summary>Long-form (YouTube)</summary><div class="treatment-body">{{ t.video.longform }}</div></details>{% endif %}
          {% if t.video.reel %}<details class="treatment"><summary>Reel (IG / FB)</summary><div class="treatment-body">{{ t.video.reel }}</div></details>{% endif %}
          {% if t.video.short %}<details class="treatment"><summary>Short (YT / TikTok)</summary><div class="treatment-body">{{ t.video.short }}</div></details>{% endif %}
        {% endif %}

        <div class="score-grid">
          {% for s in t.scores %}
          <div class="score-chip"><span class="score-label">{{ s.label }}</span><span class="score-value">{{ s.value }}</span></div>
          {% endfor %}
        </div>

        {% if page_type == 'research' and t.internalSignal %}
        <div class="signal-panel">
          <p class="signal-heading">Internal signal</p>
          <p class="signal-body">{{ t.internalSignal }}</p>
        </div>
        {% endif %}

        {% if page_type == 'blogs' %}
        <div class="card-actions">
          <button type="button" class="copy-button copy-button-primary" data-action="copy" data-copy-id="{{ t.id }}:blog" data-label="Copy Blog Prompt">Copy Blog Prompt</button>
          {% if t.blog.searchAtlasBrief %}<button type="button" class="copy-button copy-button-secondary" data-action="copy" data-copy-id="{{ t.id }}:brief" data-label="Copy SearchAtlas Brief">Copy SearchAtlas Brief</button>{% endif %}
        </div>
        {% elif page_type == 'videos' %}
        <div class="card-actions">
          <button type="button" class="copy-button copy-button-primary" data-action="copy" data-copy-id="{{ t.id }}:script" data-label="Copy Script Prompt">Copy Script Prompt</button>
          <button type="button" class="copy-button copy-button-secondary" data-action="copy" data-copy-id="{{ t.id }}:production" data-label="Copy Production Prompt">Copy Production Prompt</button>
        </div>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  <div class="footer">
    Graeham Watts · REALTOR · Intero Real Estate · DRE# {{ dre }} · graehamwatts.com<br>
    {{ page_title }} · {{ week.label }} · Template v{{ prov.version }} · Generated {{ prov.generated_at }}
  </div>
</div>

<div aria-live="polite" class="sr-only" id="a11y-status" style="position:absolute;left:-9999px"></div>
<script id="COPY_PROMPTS" type="application/json">{{ prompts_json|safe }}</script>
<script>
(function(){
  var map={};
  try{map=JSON.parse(document.getElementById("COPY_PROMPTS").textContent)}catch(e){map={}}
  function announce(m){var s=document.getElementById("a11y-status");if(s)s.textContent=m}
  document.addEventListener("click",function(ev){
    var b=ev.target.closest("[data-action='copy']");if(!b)return;
    var text=map[b.dataset.copyId];if(!text){announce("Nothing to copy");return}
    var done=function(){var lbl=b.dataset.label;b.dataset.state="copied";b.textContent="Copied";announce("Copied "+lbl);
      setTimeout(function(){b.dataset.state="";b.textContent=lbl},1400)};
    if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(done).catch(function(){fallback(text,done)})}
    else{fallback(text,done)}
  });
  function fallback(text,done){var ta=document.createElement("textarea");ta.value=text;ta.style.position="fixed";ta.style.left="-9999px";
    document.body.appendChild(ta);ta.select();try{document.execCommand("copy");done()}catch(e){}document.body.removeChild(ta)}
})();
</script>
</body>
</html>
